# PubRooter Environment Variables
# Copy this file to .env and replace with your actual values

# Database Configuration (Required)
DATABASE_URL=postgresql://username:password@localhost:5432/pubrooter

# OpenAlex API Configuration (Optional - for journal discovery)
OPENALEX_BASE_URL=https://api.openalex.org
# OpenAlex rate limiting (default: 100 requests per 5 minutes)
# OPENALEX_MAX_REQUESTS=100
# OPENALEX_TIME_WINDOW_MS=300000

# Crossref API Configuration (Optional)
CROSSREF_USER_AGENT=PubRooter/1.0 (mailto:your-email@example.com)
# Crossref API rate limiting (default: 50 requests per 5 minutes)
# CROSSREF_MAX_REQUESTS=50
# CROSSREF_TIME_WINDOW_MS=300000

# Europe PMC API Configuration (Optional)
EUROPEPMC_API_KEY=your_europepmc_api_key
# Europe PMC rate limiting (default: 5 requests per second)
# EUROPEPMC_MAX_REQUESTS=5
# EUROPEPMC_TIME_WINDOW_MS=1000

# Application Configuration
APP_NAME=PubRooter
APP_URL=http://localhost:3000
NODE_ENV=development

# Client (Vite) Configuration — used by the browser app
# Maximum manuscript PDF upload size in megabytes (client-side enforced)
VITE_MAX_UPLOAD_MB=25

# Colabwize shared Supabase backend (leave blank to run in local-only
# passphrase mode). When set, PubRooter uses the same auth.users as
# Colabwize — one account across both products — and stores workspace
# rows in the shared database.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Base URL of Colabwize for the "Continue with Colabwize" handoff
VITE_COLABWIZE_URL=https://colabwize.com

# Storage Configuration
UPLOAD_MAX_SIZE=10485760  # 10MB
UPLOAD_ALLOWED_TYPES=application/pdf,text/plain

# Security Configuration
SESSION_SECRET=your_session_secret_here
ENCRYPTION_KEY=your_encryption_key_here

# Logging Configuration
LOG_LEVEL=info
LOG_FILE=logs/app.log

# External Service Timeouts (in milliseconds)
DEFAULT_TIMEOUT=30000
API_TIMEOUT=15000

# Cache Configuration
CACHE_TTL=3600  # 1 hour in seconds
REDIS_URL=redis://localhost:6379

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# Monitoring
SENTRY_DSN=your_sentry_dsn_here
VERCEL_ANALYTICS_ID=your_analytics_id_here